<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>net.arnx</groupId>
    <artifactId>jsonic</artifactId>
    <packaging>jar</packaging>
    <name>jsonic</name>
    <version>1.3.10</version>
    <description>simple json encoder/decoder for java</description>
    <url>http://jsonic.sourceforge.jp/</url>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <scm>
        <url>http://svn.sourceforge.jp/svnroot/jsonic/</url>
        <connection>scm:svn:http://svn.sourceforge.jp/svnroot/jsonic/</connection>
    </scm>
    <developers>
        <developer>
            <id>hidekatsu.izuno</id>
            <name>Hidekatsu Izuno</name>
            <email>hidekatsu.izuno@gmail.com</email>
        </developer>
    </developers>
    <repositories>
        <repository>
            <id>maven.seasar.org</id>
            <url>https://maven.seasar.org/maven2/</url>
        </repository>
    </repositories>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>
    <dependencies>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>servlet-api</artifactId>
            <version>2.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring</artifactId>
            <version>2.5.6</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
            <version>2.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.seasar.container</groupId>
            <artifactId>s2-framework</artifactId>
            <version>2.4.43</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>commons-beanutils</groupId>
            <artifactId>commons-beanutils</artifactId>
            <version>1.8.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-webapp</artifactId>
            <version>7.0.0.v20091005</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
            <version>1.10.15</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <workingDirectory>${project.build.directory}/test-work</workingDirectory>
                    <!-- Existing date/time assertions use the Japanese locale and JST. -->
                    <argLine>-Duser.language=ja -Duser.country=JP -Duser.timezone=Asia/Tokyo -Djava.locale.providers=COMPAT,CLDR</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>prepare-web-test-samples</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <copy todir="${project.build.directory}/test-work/sample">
                                    <fileset dir="sample" excludes="**/classes/**,**/lib/**,**/*.dat"/>
                                </copy>
                                <mkdir dir="${project.build.directory}/test-work/sample/basic/WEB-INF/classes"/>
                                <javac srcdir="${project.build.directory}/test-work/sample/basic/WEB-INF/src" destdir="${project.build.directory}/test-work/sample/basic/WEB-INF/classes"
                                       release="8" encoding="UTF-8" includeantruntime="false">
                                    <classpath refid="maven.test.classpath"/>
                                </javac>
                                <copy todir="${project.build.directory}/test-work/sample/basic/WEB-INF/classes">
                                    <fileset dir="${project.build.directory}/test-work/sample/basic/WEB-INF/src" excludes="**/*.java"/>
                                </copy>
                                <mkdir dir="${project.build.directory}/test-work/sample/spring/WEB-INF/classes"/>
                                <javac srcdir="${project.build.directory}/test-work/sample/spring/WEB-INF/src" destdir="${project.build.directory}/test-work/sample/spring/WEB-INF/classes"
                                       release="8" encoding="UTF-8" includeantruntime="false">
                                    <classpath refid="maven.test.classpath"/>
                                </javac>
                                <copy todir="${project.build.directory}/test-work/sample/spring/WEB-INF/classes">
                                    <fileset dir="${project.build.directory}/test-work/sample/spring/WEB-INF/src" excludes="**/*.java"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-ant-classloader</id>
                        <phase>test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <target>
                                <taskdef name="testClassLoader"
                                         classname="net.arnx.jsonic.JSONMultiClassLoaderTestTask"
                                         classpathref="maven.test.classpath"/>
                                <testClassLoader/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
